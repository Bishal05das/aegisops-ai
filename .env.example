# =============================================================================
# AegisOps AI — environment configuration
#
# Copy to .env and adjust:   make env
#
# Host port choices are NOT the upstream defaults. This machine already runs a
# native PostgreSQL (5432, 5433) and a native Redis (6379), so the Compose stack
# publishes on 5434 / 6380 to avoid colliding with them. Container-to-container
# traffic still uses the standard ports on the internal network.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
AEGIS_ENV=development                 # development | staging | production
AEGIS_LOG_LEVEL=debug                 # debug | info | warn | error
AEGIS_LOG_FORMAT=text                 # text (dev) | json (prod)
AEGIS_LOG_SOURCE=true                 # attach file:line (costs a runtime.Callers per record)

# ---- HTTP API (Phase 2) -----------------------------------------------------
AEGIS_HTTP_ADDR=:8080
AEGIS_HTTP_READ_HEADER_TIMEOUT=5s     # bounds Slowloris
AEGIS_HTTP_READ_TIMEOUT=15s           # bounds a slow request body
AEGIS_HTTP_WRITE_TIMEOUT=30s          # backstop; must exceed REQUEST_TIMEOUT
AEGIS_HTTP_REQUEST_TIMEOUT=25s        # per-request context deadline
AEGIS_HTTP_IDLE_TIMEOUT=120s          # reclaims idle keep-alives
AEGIS_HTTP_SHUTDOWN_GRACE=20s         # how long a deploy waits for in-flight work
AEGIS_HTTP_MAX_BODY_BYTES=1048576
# Empty disables CORS entirely, which is correct for an API with no browser
# clients. "*" is rejected in production.
AEGIS_HTTP_CORS_ORIGINS=

# ---- Metrics / tracing (Phase 11) -------------------------------------------
AEGIS_METRICS_ADDR=:9091
AEGIS_OTLP_ENDPOINT=localhost:4317
AEGIS_TRACING_ENABLED=false
AEGIS_SERVICE_NAME=aegisopsd

# ---- PostgreSQL + pgvector (Phase 3 / 9) ------------------------------------
AEGIS_PG_HOST=localhost
AEGIS_PG_PORT=5434
AEGIS_PG_USER=aegis
AEGIS_PG_PASSWORD=aegis_dev_password
AEGIS_PG_DATABASE=aegisops
AEGIS_PG_SSLMODE=disable
AEGIS_PG_MAX_CONNS=20
AEGIS_PG_MIN_CONNS=2
AEGIS_PG_CONN_MAX_LIFETIME=30m
# Apply pending migrations on startup. Safe across replicas: the runner holds a
# Postgres advisory lock. Set false where a separate migration job is preferred.
AEGIS_DB_AUTO_MIGRATE=true

# ---- Redis — short-term memory (Phase 9) ------------------------------------
AEGIS_REDIS_HOST=localhost
AEGIS_REDIS_PORT=6380
AEGIS_REDIS_PASSWORD=
AEGIS_REDIS_DB=0

# ---- RabbitMQ — event bus (Phase 5) -----------------------------------------
AEGIS_EVENTBUS_DRIVER=inproc          # inproc | rabbitmq
AEGIS_AMQP_HOST=localhost
AEGIS_AMQP_PORT=5672
AEGIS_AMQP_USER=aegis
AEGIS_AMQP_PASSWORD=aegis_dev_password
AEGIS_AMQP_VHOST=/
AEGIS_AMQP_EXCHANGE=aegisops.events

# ---- Local LLM (Phase 8) ----------------------------------------------------
# Provider is pluggable; nothing above the port knows which one is wired in.
AEGIS_LLM_PROVIDER=ollama             # ollama | llamacpp | mock
AEGIS_LLM_ENDPOINT=http://localhost:11434
AEGIS_LLM_MODEL=qwen2.5:7b
AEGIS_LLM_EMBED_MODEL=nomic-embed-text
AEGIS_LLM_TIMEOUT=120s
AEGIS_LLM_MAX_TOKENS=2048
AEGIS_LLM_TEMPERATURE=0.1

# ---- Security (Phase 4) -----------------------------------------------------
# Generate a real one with:  make gen-secret
AEGIS_JWT_SECRET=change-me-in-production-min-32-bytes-long
AEGIS_JWT_ACCESS_TTL=15m
AEGIS_JWT_REFRESH_TTL=168h
AEGIS_JWT_ISSUER=aegisops-ai
AEGIS_RATE_LIMIT_RPS=20               # global API budget, per principal
AEGIS_RATE_LIMIT_BURST=40             # must be >= RPS
# Login is throttled separately and far more tightly (5 attempts, then one per
# 10s), keyed by BOTH client address and account: address-only limiting is
# defeated by a botnet spreading guesses, and account-only limiting lets an
# attacker lock out an account they do not own.

# ---- Harness (Phase 6) ------------------------------------------------------
# The execution boundary. These three values decide how much this deployment is
# allowed to do on its own.

# Dry run logs full intent and returns synthetic success without touching
# infrastructure. Leaving it on is safe; turning it off is a deliberate act, and
# the daemon logs LIVE EXECUTION ENABLED at WARN when you do.
AEGIS_HARNESS_DRY_RUN=true

# How long a proposal waits for a human before it expires.
#
# Expiry is a safety control, not tidiness: without it, a restart proposed during
# Tuesday's outage can be approved on Friday against a system that has since been
# fixed, redeployed or rolled back.
AEGIS_HARNESS_APPROVAL_TIMEOUT=30m

# The riskiest action that may execute WITHOUT asking a human.
#
#   none   nothing is automatic; even reading logs waits for approval
#   low    read-only actions run; anything mutating waits          (default)
#   medium container restarts and scaling run automatically
#   high   rollbacks and service restarts run automatically
#
# Above the ceiling an action is ESCALATED, not refused — an operator can still
# approve it. Lowering this tightens every action at once without editing a
# policy row; raising it cannot loosen an action whose policy demands approval.
#
# No value here reaches a `forbidden` action. Dropping a table has no path
# through this system at any setting, which is the point of that tier existing.
AEGIS_HARNESS_MAX_AUTO_RISK=low
